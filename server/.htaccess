# =========================================================================
# MIB — .htaccess de production (OVH Hébergement Pro, Apache)
# Sécurité, cache de pages statique, compression, cache navigateur.
# Déployé automatiquement à la racine WordPress par GitHub Actions.
# =========================================================================

Options -Indexes
ServerSignature Off

# --- 1. HTTPS forcé + domaine canonique sans www ---------------------------
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://maninback.com%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^www\.maninback\.com$ [NC]
RewriteRule ^ https://maninback.com%{REQUEST_URI} [L,R=301]
</IfModule>

# --- 2. En-têtes de sécurité -----------------------------------------------
<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()"
Header always set Cross-Origin-Opener-Policy "same-origin"
# CSP stricte pour le site public. L'admin WordPress a besoin de 'unsafe-eval' : on l'en exclut.
<If "%{REQUEST_URI} !~ m#^/wp-(admin|login)#">
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
</If>
Header always unset X-Powered-By
Header unset X-Pingback
</IfModule>

# --- 3. Blocages ------------------------------------------------------------
<Files xmlrpc.php>
	Require all denied
</Files>
<FilesMatch "^(wp-config(-mib)?\.php|readme\.html|license\.txt|\.htaccess|.*\.(log|sql|bak|ini|sh|md))$">
	Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
RewriteEngine On
# Aucune exécution PHP dans les médias, le cache ou wp-includes.
RewriteRule ^wp-content/(uploads|cache)/.*\.(php|phtml|phar)$ - [F,L,NC]
RewriteRule ^wp-includes/[^/]+\.php$ - [F,L]
RewriteRule ^wp-includes/js/tinymce/langs/.+\.php - [F,L]
RewriteRule ^wp-includes/theme-compat/ - [F,L]
# Énumération des auteurs.
RewriteCond %{QUERY_STRING} (^|&)author=\d+ [NC]
RewriteRule ^ - [F,L]
</IfModule>

# --- 4. Cache de pages statique MIB (PHP et MySQL ne sont pas réveillés) ----
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{REQUEST_METHOD} GET
RewriteCond %{QUERY_STRING} ^$
RewriteCond %{REQUEST_URI} /$
RewriteCond %{HTTP_COOKIE} !(wordpress_logged_in|wp-postpass|comment_author|wordpress_no_cache) [NC]
RewriteCond %{DOCUMENT_ROOT}/wp-content/cache/mib/%{HTTP_HOST}%{REQUEST_URI}index.html -f
RewriteRule ^ /wp-content/cache/mib/%{HTTP_HOST}%{REQUEST_URI}index.html [L]
</IfModule>

# --- 5. Compression ----------------------------------------------------------
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/ld+json application/xml image/svg+xml
</IfModule>

# --- 6. Cache navigateur (assets versionnés : 1 an) --------------------------
<IfModule mod_expires.c>
ExpiresActive On
ExpiresDefault "access plus 0 seconds"
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType image/x-icon "access plus 1 year"
ExpiresByType text/plain "access plus 1 day"
</IfModule>
<IfModule mod_headers.c>
<FilesMatch "\.(css|js|woff2|webp|svg|ico)$">
	Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
</IfModule>
AddType font/woff2 .woff2

# --- 7. WordPress -------------------------------------------------------------
# BEGIN WordPress
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>
# END WordPress
